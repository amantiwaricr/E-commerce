# ─────────────────────────────────────────────────────────────
# Fresh Meat Nepal — Backend environment variables
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────

# ── Core ────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Public URL of the React app (used for CORS, payment redirects, tracking links)
FRONTEND_URL=http://localhost:5173
# Public URL of this API (used to build eSewa callback URLs)
BACKEND_URL=http://localhost:5000

# ── Database ────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/fresh-meat-nepal

# ── Auth ────────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web application)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# Long random string, e.g. `openssl rand -hex 48`
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
# Cookie settings ("none" + secure cookies are required for cross-site deployments)
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
COOKIE_DOMAIN=

# ── eSewa ePay v2 ───────────────────────────────────────────
# Sandbox test credentials: MERCHANT_CODE=EPAYTEST, SECRET=8gBm/:&EnhH.1/q
ESEWA_MODE=sandbox
ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
ESEWA_SANDBOX_FORM_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_SANDBOX_STATUS_URL=https://rc.esewa.com.np/api/epay/transaction/status/
ESEWA_PRODUCTION_FORM_URL=https://epay.esewa.com.np/api/epay/main/v2/form
ESEWA_PRODUCTION_STATUS_URL=https://epay.esewa.com.np/api/epay/transaction/status/
# Set to true when the merchant account has card processing enabled through eSewa
ESEWA_CARD_ENABLED=true

# ── Email (Nodemailer / SMTP) ───────────────────────────────
# For Gmail use an App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASSWORD=your-16-char-app-password
MAIL_FROM_NAME=Fresh Meat Nepal
MAIL_FROM_ADDRESS=your-gmail-address@gmail.com

# ── WhatsApp ────────────────────────────────────────────────
# provider: "meta" (WhatsApp Cloud API) | "twilio" | "none" (disable)
WHATSAPP_PROVIDER=none
# Meta Cloud API
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_TEMPLATE_NAME=order_confirmation
META_WHATSAPP_TEMPLATE_LANG=en
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Store defaults ──────────────────────────────────────────
STORE_NAME=Fresh Meat Nepal
STORE_SUPPORT_PHONE=+977-9800000000
DELIVERY_CHARGE=100
FREE_DELIVERY_THRESHOLD=3000
DEFAULT_DELIVERY_ETA=Within 24 hours inside Kathmandu Valley

# ── Seed script ─────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@freshmeatnepal.com
SEED_ADMIN_NAME=Store Admin
