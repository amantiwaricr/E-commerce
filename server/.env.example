# ─────────────────────────────────────────────────────────────
# Fresh Meat Nepal — Backend environment variables
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────

# ── Core ────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Public URL of the React app (used for CORS, payment redirects, tracking links)
FRONTEND_URL=http://localhost:5173
# Public URL of this API (used to build eSewa callback URLs)
BACKEND_URL=http://localhost:5000
# Public URL of the admin panel (separate app; allowed through CORS)
ADMIN_URL=http://localhost:5174
# Public address of the storefront. The sitemap and robots.txt this API serves
# are built from it, so in production it must be the real https:// address.
SITE_URL=http://localhost:5173

# ── Database ────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/fresh-meat-nepal

# ── Auth ────────────────────────────────────────────────────
# Long random string, e.g. `openssl rand -hex 48`
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
# Cookie settings ("none" + secure cookies are required for cross-site deployments)
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

# ── Transaction ledger signatures ────────────────────────────
# Every money movement on an order is hash-chained and signed with Ed25519,
# so an altered amount, a deleted payment or a rewritten history can all be
# detected — including by someone who only has the public key.
#
# Generate with `npm run keys:txn`; rotate with `npm run keys:txn -- rotate`.
# TXN_SIGNING_KEY is the PKCS#8 private key as base64-of-PEM. Treat it like
# the JWT secret: it never leaves the server and is never committed.
TXN_SIGNING_KEY_ID=
TXN_SIGNING_KEY=
# Public halves of retired keys, so entries signed before a rotation still
# verify: {"2025-01":"<base64 pem>"}. Managed by the rotate command.
TXN_VERIFY_KEYS=

# ── TLS / HTTPS ───────────────────────────────────────────────
# Redirect plain HTTP to HTTPS and send HSTS. Defaults to on in production.
# Turn it off only if something in front of this process already does it.
FORCE_HTTPS=
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
# Preloading is effectively irreversible — only turn it on once every
# subdomain is known to serve HTTPS.
HSTS_PRELOAD=false
# Floor for TLS on connections this server makes (eSewa, SMTP, MongoDB).
TLS_MIN_VERSION=TLSv1.2

# Serve HTTPS from Node itself instead of terminating TLS at a proxy.
# For local development run `npm run ssl:dev` and point these at the result.
# Leave blank in a normal deployment.
SSL_KEY_PATH=
SSL_CERT_PATH=
COOKIE_DOMAIN=

# ── eSewa ePay v2 ───────────────────────────────────────────
# Sandbox test credentials: MERCHANT_CODE=EPAYTEST, SECRET=8gBm/:&EnhH.1/q
ESEWA_MODE=sandbox
ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
ESEWA_SANDBOX_FORM_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_SANDBOX_STATUS_URL=https://rc.esewa.com.np/api/epay/transaction/status/
ESEWA_PRODUCTION_FORM_URL=https://epay.esewa.com.np/api/epay/main/v2/form
ESEWA_PRODUCTION_STATUS_URL=https://epay.esewa.com.np/api/epay/transaction/status/
# Set to true when the merchant account has card processing enabled through eSewa
ESEWA_CARD_ENABLED=true

# ── Email (Nodemailer / SMTP) ───────────────────────────────
# For Gmail use an App Password: https://myaccount.google.com/apppasswords
# Leave these blank while developing: verification codes are then printed in the
# server terminal and shown on the verification screen instead of being emailed.
# Fill them in to send real email. For Gmail, SMTP_PASSWORD must be an App
# Password (https://myaccount.google.com/apppasswords), not your login password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME=Fresh Meat Nepal
MAIL_FROM_ADDRESS=

# ── WhatsApp ────────────────────────────────────────────────
# ── Which order updates email the customer ───────────────────
# Comma-separated order statuses. The default announces the two ends of the
# journey plus a cancellation; "processing" and "shipped" are left out on
# purpose, so a same-day order does not generate four emails.
# Valid: pending, confirmed, processing, shipped, delivered, cancelled
# Leave empty to send no status emails at all (the order confirmation that
# goes out at checkout is separate and always sent).
ORDER_STATUS_EMAILS=confirmed,delivered,cancelled

# provider: "meta" (WhatsApp Cloud API) | "twilio" | "none" (disable)
WHATSAPP_PROVIDER=none
# Meta Cloud API
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_TEMPLATE_NAME=order_confirmation
META_WHATSAPP_TEMPLATE_LANG=en
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Store defaults ──────────────────────────────────────────
STORE_NAME=Fresh Meat Nepal
STORE_SUPPORT_PHONE=+977-9800000000
DELIVERY_CHARGE=100
FREE_DELIVERY_THRESHOLD=3000
# Printed on the PDF bill customers download for a delivered order.
STORE_SUPPORT_EMAIL=
STORE_ADDRESS=Balkumari Chowk, Balkumari, Lalitpur 44700, Nepal
# Leave the registration number empty if the shop is not VAT/PAN registered —
# the line is then left off the bill rather than invented.
STORE_REGISTRATION_NUMBER=
STORE_REGISTRATION_LABEL=PAN
DEFAULT_DELIVERY_ETA=Within 24 hours inside Kathmandu Valley

# ── Seed script ─────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@freshmeatnepal.com
SEED_ADMIN_NAME=Store Admin
# Password for the seeded admin account (min 8 characters).
# Leave blank and `npm run seed` will generate one and print it once.
SEED_ADMIN_PASSWORD=
