# ─────────────────────────────────────────────────────────────
# Fresh Meat Nepal — Frontend environment variables (Vite)
# Copy to `.env` — only VITE_* names reach the browser bundle.
# Never put secrets here: everything in this file ships to clients.
# ─────────────────────────────────────────────────────────────

# Base URL of the Express API
VITE_API_URL=http://localhost:5000/api

# Landing-page hero photograph (wide, dark shots work best).
# Leave blank to use the best-rated product's image instead.
VITE_HERO_IMAGE=

# Store branding
VITE_STORE_NAME=Fresh Meat Nepal
VITE_SUPPORT_PHONE=+977-9800000000
VITE_SUPPORT_EMAIL=hello@freshmeatnepal.com

# Shop address, shown on the landing page and in its footer
VITE_STORE_ADDRESS_LINE1=Balkumari Chowk, Balkumari
VITE_STORE_ADDRESS_LINE2=Lalitpur 44700, Bagmati Province, Nepal
VITE_STORE_HOURS=Sunday to Friday, 7:00 AM - 8:00 PM · Saturday, 7:00 AM - 2:00 PM

# What the embedded map and the directions links point at.
VITE_STORE_MAP_QUERY=Balkumari Chowk, Balkumari, Lalitpur, Nepal
# Optional: a full Google Maps Embed API URL (needs an API key). Leave blank to
# use the keyless embed, which works with no key and no billing account.
VITE_STORE_MAP_EMBED_URL=

# Guest-cart delivery preview (must mirror the server's DELIVERY_CHARGE / FREE_DELIVERY_THRESHOLD)
VITE_DELIVERY_CHARGE=100
VITE_FREE_DELIVERY_THRESHOLD=3000
