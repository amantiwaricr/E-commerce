# ─────────────────────────────────────────────────────────────
# Fresh Meat Nepal — Admin panel environment (Vite)
# Copy to `.env`. Only VITE_* names reach the browser bundle,
# so never put a secret here.
# ─────────────────────────────────────────────────────────────

# Base URL of the Express API
VITE_API_URL=http://localhost:5000/api

VITE_STORE_NAME=Fresh Meat Nepal
# Where the "View store" link points
VITE_STOREFRONT_URL=http://localhost:5173
